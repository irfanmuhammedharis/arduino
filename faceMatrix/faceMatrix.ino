#include <LedControl.h>

int DIN = D7; // D0
int CS =  D8;  // D1
int CLK = D5;  // D2


LedControl lc=LedControl(DIN,CLK,CS,1);

void setup(){
 lc.shutdown(0,false);       //The MAX72XX is in power-saving mode on startup
 lc.setIntensity(0,15);      // Set the brightness to maximum value
 lc.clearDisplay(0);         // and clear the display
}

void loop(){ 

    byte a[8] = {0x00,0x00,0x00,0x00,0xFF,0x7E,0x3C,0x00,}; // Ec
    byte b[8] = {0x00,0x3C,0x42,0x99,0x99,0x42,0x3C,0x00,}; // EO
    byte c[8] = {0x00,0x3C,0x42,0x99,0x99,0x42,0x3C,0x00,}; // EO
    byte d[8] = {0x00,0x3C,0x42,0x8D,0x8D,0x42,0x3C,0x00,}; // ER
    byte e[8] = {0x00,0x3C,0x42,0xB1,0xB1,0x42,0x3C,0x00,}; // EL
    
    byte f[8] = {0x00,0x3C,0x5A,0x99,0x81,0x42,0x3C,0x00,}; // EU
    byte g[8] = {0x00,0x3C,0x42,0x81,0x99,0x5A,0x3C,0x00,}; // ED
    byte h[8] = {0x00,0x00,0x00,0xFF,0x99,0x5A,0x3C,0x00,}; // PC
    byte i[8] = {0x00,0x00,0x00,0x00,0xFF,0x7E,0x3C,0x00,}; // EC
    byte j[8] = {0x00,0x00,0x00,0x00,0xFF,0x7E,0x3C,0x00,}; // EC

    printByte(a);
    delay(1000);

    printByte(b);
    delay(1000);

    printByte(c);
    delay(1000);

    printByte(d);
    delay(1000);

    printByte(e);
    delay(1000);

    printByte(f);
    delay(1000);

    printByte(g);
    delay(1000);

    printByte(h);
    delay(1000);


    printByte(i);
    delay(1000);

    printByte(j);
    delay(1000);
}
void printByte(byte character [])
{
  int i = 0;
  for(i=0;i<8;i++)
  {
    lc.setRow(0,i,character[i]);
  }
}
